{
	"configurePresets":
	[
		{ "name": "gcc", "generator": "Ninja", "binaryDir": "${sourceDir}/build/gcc", "cacheVariables":
		{
			"CMAKE_C_COMPILER": "gcc",
			"CMAKE_CXX_COMPILER": "g++" }
		},
		{ "name": "msvc", "generator": "Ninja", "binaryDir": "${sourceDir}/build/msvc", "cacheVariables":
		{
			"CMAKE_C_COMPILER": "cl",
			"CMAKE_CXX_COMPILER": "cl" }
		},
		{ "name": "clang", "generator": "Ninja", "binaryDir": "${sourceDir}/build/clang", "cacheVariables":
		{
			"CMAKE_C_COMPILER": "clang",
			"CMAKE_CXX_COMPILER": "clang++" }
		}
	],
	"buildPresets":
	[
		{ "name": "gcc", "configurePreset": "gcc" },
		{ "name": "msvc", "configurePreset": "msvc" },
		{ "name": "clang", "configurePreset": "clang" }
	],
	"testPresets":
	[
		{ "name": "gcc", "configurePreset": "gcc" },
		{ "name": "msvc", "configurePreset": "msvc" },
		{ "name": "clang", "configurePreset": "clang" }
	],
	"version": 3
}
